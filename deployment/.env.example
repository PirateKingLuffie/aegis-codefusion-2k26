POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-a-long-random-value
AEGIS_ALLOWED_ORIGINS=https://aegis.example.org
AEGIS_PUBLIC_DATA_USER_AGENT=AEGIS/1.0 (contact: operator@example.org)
AEGIS_RATE_LIMIT_PER_MINUTE=240
AEGIS_MAX_PAYLOAD_BYTES=2000000
AEGIS_WEBSOCKET_REPLAY_LIMIT=1000
AEGIS_LOG_LEVEL=INFO
AEGIS_DOMAIN=aegis.example.org
AEGIS_PUBLIC_URL=http://127.0.0.1
AEGIS_TLS_ENABLED=false

# Optional server-only Agent Ledger briefing providers. The deterministic
# engine remains available when these are blank.
OPENAI_COMPATIBLE_PROVIDER=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
