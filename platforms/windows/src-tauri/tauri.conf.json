{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEGIS",
  "version": "0.1.0",
  "identifier": "in.codefusion.aegis",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run web:verify",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AEGIS - Emergency Command Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' data: https:; media-src 'self' blob: https:; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "Team X",
    "shortDescription": "Emergency geospatial intelligence and simulation",
    "longDescription": "AEGIS combines source-labelled live intelligence, deterministic hazard simulation and human-approved evacuation planning in a shared command-center interface.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "AEGIS"
      }
    }
  }
}
