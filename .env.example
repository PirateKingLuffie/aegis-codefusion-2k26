# AEGIS zero-cost online mode needs no browser map key, AI key or billing account.

# Optional identifiable User-Agent suffix for public OSM/OSRM/Overpass requests.
# Example: "AEGIS/0.1 (contact: team@example.com)"
AEGIS_PUBLIC_DATA_USER_AGENT=

# Durable API. Docker Compose sets this to http://api:8080 automatically.
AEGIS_OPERATIONS_API_URL=http://127.0.0.1:8080

# Optional account-bound adapters remain disabled when absent. They are not
# required for the complete zero-cost demo and are never shown as missing UI.
RELIEFWEB_APPNAME=
YOUTUBE_API_KEY=

# Optional AEGIS Agent Ledger providers. The ledger remains fully usable with
# the deterministic local engine when all of these are blank. Keys are read on
# the server only; never rename them with a NEXT_PUBLIC_ prefix.
# Generic OpenAI-compatible endpoint (HTTPS is required).
OPENAI_COMPATIBLE_PROVIDER=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional Groq free-tier account. The value is never returned by the API or
# written to audit receipts. Use the generic provider above for true failover.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
